---
layout: layouts/base.njk
title: Sergio Palomino Gámez — Welcome
bodyClass: welcome-body
permalink: /index.html
---
<main class="welcome-hero" data-welcome-interval="{{ portfolio.welcome.secondsPerImage or 5 }}">
  <div class="welcome-slides" aria-hidden="true">
    {% for image in portfolio.welcome.images %}
      <div class="welcome-slide {% if loop.first %}is-active{% endif %}" {% if image %}style="background-image:url('{{ image }}')"{% endif %}></div>
    {% endfor %}
  </div>

  <section class="welcome-card">
    <p class="welcome-card-role">{{ portfolio.role }}</p>
    <h1 class="welcome-card-name">Sergio<br>Palomino Gámez</h1>
    <nav class="welcome-card-nav" aria-label="Portfolio navigation">
      <a href="/tasting-menu/">Portfolio</a>
      <a href="/about/">About</a>
      <a href="/projects/">Projects</a>
    </nav>
  </section>

  <div class="welcome-socials" aria-label="Social links">
    {% if portfolio.social.instagram %}
    <a class="social-icon" href="{{ portfolio.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect><circle cx="12" cy="12" r="4.1"></circle><circle class="social-dot" cx="17.4" cy="6.8" r="1"></circle></svg>
    </a>
    {% endif %}
    {% if portfolio.social.linkedin %}
    <a class="social-icon" href="{{ portfolio.social.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 9v9"></path><path d="M6.5 6.2h.01"></path><path d="M10.5 18v-5.1c0-2.6 1.5-4.1 3.6-4.1 2.2 0 3.4 1.5 3.4 4.1V18"></path><path d="M10.5 9v9"></path></svg>
    </a>
    {% endif %}
    {% if portfolio.social.email %}
    <a class="social-icon" href="mailto:{{ portfolio.social.email }}" aria-label="Email">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17z"></path><path d="m4.3 7.3 7.7 6 7.7-6"></path></svg>
    </a>
    {% endif %}
  </div>
</main>
