<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-name">{{ portfolio.name }}</span>
    <span class="brand-role">{{ portfolio.role | lower }}</span>
  </a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href="/" {% if active == 'welcome' %}class="active"{% endif %}>{{ theme.navWelcomeLabel or 'Welcome' }}</a>
    <a href="/tasting-menu/" {% if active == 'tasting' %}class="active"{% endif %}>{{ theme.navTastingLabel or 'Tasting Menu' }}</a>
    <a href="/projects/" {% if active == 'projects' %}class="active"{% endif %}>{{ theme.navProjectsLabel or 'Projects' }}</a>
    <a href="/about/" {% if active == 'about' %}class="active"{% endif %}>{{ theme.navAboutLabel or 'About' }}</a>
  </nav>
</header>
